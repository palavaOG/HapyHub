local function CreateToggle(
	parent,
	text,
	setting
)

	local Button =
		Instance.new("TextButton")

	Button.Size =
		UDim2.new(
			1,
			0,
			0,
			38
		)

	Button.BackgroundColor3 =
		Config.ButtonColor

	Button.BorderSizePixel = 0

	Button.Text = ""

	Button.AutoButtonColor = false

	Button.Parent =
		parent

	local Corner =
		Instance.new("UICorner")

	Corner.CornerRadius =
		UDim.new(0, 8)

	Corner.Parent =
		Button

	local Label =
		Instance.new("TextLabel")

	Label.Size =
		UDim2.new(
			1,
			-70,
			1,
			0
		)

	Label.Position =
		UDim2.new(
			0,
			12,
			0,
			0
		)

	Label.BackgroundTransparency = 1

	Label.Text =
		text

	Label.TextColor3 =
		Config.TextColor

	Label.TextSize = 14

	Label.Font =
		Enum.Font.Gotham

	Label.TextXAlignment =
		Enum.TextXAlignment.Left

	Label.Parent =
		Button

	local State =
		Instance.new("TextLabel")

	State.Size =
		UDim2.new(
			0,
			45,
			1,
			0
		)

	State.Position =
		UDim2.new(
			1,
			-52,
			0,
			0
		)

	State.BackgroundTransparency = 1

	State.TextSize = 13

	State.Font =
		Enum.Font.GothamBold

	State.Parent =
		Button

	local function Update()

		if Settings[setting] then

			State.Text = "ON"

			State.TextColor3 =
				Color3.fromRGB(
					75,
					200,
					105
				)

			Button.BackgroundColor3 =
				Config.ButtonOnColor

		else

			State.Text = "OFF"

			State.TextColor3 =
				Config.MutedTextColor

			Button.BackgroundColor3 =
				Config.ButtonColor

		end

	end

	Button.MouseButton1Click:Connect(
		function()

			Settings[setting] =
				not Settings[setting]

			Update()

		end
	)

	ToggleButtons[setting] =
		Update

	Update()

	return Button
end

