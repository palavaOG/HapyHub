--==================================================
-- SLIDER LOGIC
--==================================================

local Sliding = false

local function UpdateDistance(input)

	local X =
		input.Position.X

	local AbsolutePosition =
		SliderBackground.AbsolutePosition.X

	local AbsoluteSize =
		SliderBackground.AbsoluteSize.X

	local Percent =
		math.clamp(
			(X - AbsolutePosition) /
				AbsoluteSize,
			0,
			1
		)

	local Range =
		Config.MaxDistance -
		Config.MinDistance

	local Distance =
		Config.MinDistance +
		(Range * Percent)

	Distance =
		math.floor(
			Distance /
				Config.DistanceStep
		) *
			Config.DistanceStep

	Distance =
		math.clamp(
			Distance,
			Config.MinDistance,
			Config.MaxDistance
		)

	Settings.MaxDistance =
		Distance

	local Normalized =
		(Distance -
			Config.MinDistance) /
			Range

	SliderFill.Size =
		UDim2.new(
			Normalized,
			0,
			1,
			0
		)

	SliderKnob.Position =
		UDim2.new(
			Normalized,
			0,
			0.5,
			0
		)

	DistanceValue.Text =
		tostring(Distance) ..
		" studs"

end

DistanceValue.Text =
	tostring(Settings.MaxDistance) ..
	" studs"

SliderBackground.InputBegan:Connect(
	function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1 then

			Sliding = true

			UpdateDistance(input)

		end

	end
)

UserInputService.InputChanged:Connect(
	function(input)

		if Sliding
			and input.UserInputType ==
			Enum.UserInputType.MouseMovement then

			UpdateDistance(input)

		end

	end
)

UserInputService.InputEnded:Connect(
	function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1 then

			Sliding = false

		end

	end
)

